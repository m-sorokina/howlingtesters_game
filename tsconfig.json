{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "paths": {
      "@components": ["./src/components"],
      "@config": ["./src/config"],
      "@consts": ["./src/consts"],
      "@fixtures": ["./src/fixtures"],
      "@helpers": ["./src/helpers"],
      "@models": ["./src/models"],
      "@pages": ["./src/pages"],
      "@types": ["./src/types"],
      "@data/*": ["./data/*"],
      "@assertions": ["./src/assertions"],
      "@content": ["./src/content"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "data/**/*.json", "playwright.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
